MCP_GATEWAY_ENCRYPTION_KEY=<your_base64_encoded_32_byte_key> # Generate: openssl rand -base64 32
# Only needed if config.yaml logs users in through an OIDC provider (auth.oidc)
# OIDC_CLIENT_ID=<client id registered at your identity provider>
# OIDC_CLIENT_SECRET=<client secret; omit for a public PKCE-only client>
